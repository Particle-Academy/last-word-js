{
  "name": "@particle-academy/last-word",
  "version": "0.2.0",
  "description": "Zero-dependency, isomorphic docx writer/reader for agentic word-processing documents — JSON model + markdown bridges. Sister to holy-sheet (xlsx) and dark-slide (pptx). The Node/TypeScript mirror of the PHP particle-academy/last-word.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/last-word-js.git"
  },
  "homepage": "https://github.com/Particle-Academy/last-word-js#readme",
  "bugs": "https://github.com/Particle-Academy/last-word-js/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "docx",
    "word",
    "document",
    "ooxml",
    "markdown",
    "editor",
    "agent",
    "fancy",
    "human-plus"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
